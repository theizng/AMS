<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AMS.Views.MainPage"
             Title="Quản Lý Nhà Trọ">

    <ScrollView>
        <!-- Define 6 rows: Header + 4 KPI rows + Quick Actions -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto"
                  BackgroundColor="#f5f5f5" Padding="15,10">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Ngày giờ hiện tại" FontSize="12" TextColor="#666666" />
                    <Label Text="{Binding CurrentDateTime, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}"
                           FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                    <Label Text="Đăng nhập với" FontSize="12" TextColor="#666666" />
                    <Label Text="{Binding CurrentUser}" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>

            <!-- Row 1: Rooms / Revenue -->
            <Grid Grid.Row="1" Margin="10" ColumnDefinitions="*, *">
                <Frame Grid.Column="0" Margin="5" BorderColor="#E0E0E0" CornerRadius="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Tổng số phòng" FontSize="14" TextColor="#666666" />
                        <Label Text="{Binding TotalRooms}" FontSize="24" FontAttributes="Bold" TextColor="#3498db" />
                        <HorizontalStackLayout>
                            <Label Text="{Binding OccupiedRooms}" TextColor="#e74c3c" />
                            <Label Text=" phòng đang thuê" TextColor="#666666" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="{Binding InactiveRooms}" TextColor="#B71C1C" />
                            <Label Text=" phòng không hoạt động" TextColor="#666666" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding OccupancyRate, StringFormat='Tỷ lệ: {0:F2}%'}" FontSize="12" TextColor="#666666"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Margin="5" BorderColor="#E0E0E0" CornerRadius="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Doanh thu tháng trước" FontSize="14" TextColor="#666666" />
                        <Label Text="{Binding MonthlyRevenue, StringFormat='{0:N0} VNĐ'}"
                               FontSize="24" FontAttributes="Bold" TextColor="#2ecc71" />
                        <Label Text="{Binding LastMonthDate, StringFormat='Tháng {0:MM/yyyy}'}" TextColor="#666666" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Row 2: Debt / Maintenance -->
            <Grid Grid.Row="2" Margin="10" ColumnDefinitions="*, *">
                <Frame Grid.Column="0" Margin="5" BorderColor="#E0E0E0" CornerRadius="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Công nợ tháng này" FontSize="14" TextColor="#666666" />
                        <Label Text="{Binding CurrentDebt, StringFormat='{0:N0} VNĐ'}"
                               FontSize="24" FontAttributes="Bold" TextColor="#e67e22" />
                        <Label Text="{Binding DebtRooms, StringFormat='{0} phòng chưa thanh toán'}" TextColor="#666666" />
                        <Label Text="{Binding LatePaymentRooms, StringFormat='{0} phòng trễ hạn'}" FontSize="12" TextColor="#c0392b" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Margin="5" BorderColor="#E0E0E0" CornerRadius="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Bảo trì/Sự cố" FontSize="14" TextColor="#666666" />
                        <Label Text="{Binding PendingMaintenance}" FontSize="24"
                               FontAttributes="Bold" TextColor="#9b59b6" />
                        <Label Text="yêu cầu đang chờ xử lý" TextColor="#666666" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Row 3: Contracts -->
            <Grid Grid.Row="3" Margin="10" ColumnDefinitions="*, *">
                <Frame Grid.Column="0" Margin="5" BorderColor="#E0E0E0" CornerRadius="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Hợp đồng sắp hết hạn (30 ngày)" FontSize="14" TextColor="#666666" />
                        <Label Text="{Binding ExpiringContractsCount}" FontSize="24" FontAttributes="Bold" TextColor="#d35400" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Margin="5" BorderColor="#E0E0E0" CornerRadius="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Hợp đồng cần phụ lục" FontSize="14" TextColor="#666666" />
                        <Label Text="{Binding AddendumNeededCount}" FontSize="24" FontAttributes="Bold" TextColor="#8e44ad" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Row 4: Tenants / Due Reminder -->
            <Grid Grid.Row="4" Margin="10" ColumnDefinitions="*, *">
                <Frame Grid.Column="0" Margin="5" BorderColor="#E0E0E0" CornerRadius="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Người thuê hiện tại" FontSize="14" TextColor="#666666" />
                        <Label Text="{Binding TenantCount}" FontSize="24" FontAttributes="Bold" TextColor="#16a085" />
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Column="1" Margin="5" BorderColor="#E0E0E0" CornerRadius="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Nhắc ngày thu phí" FontSize="14" TextColor="#666666" />
                        <Label Text="{Binding UpcomingDueReminder}" FontSize="12" TextColor="#666666" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Row 5: Quick Actions -->
            <Grid Grid.Row="5" Margin="10" ColumnDefinitions="*, *" RowDefinitions="Auto,Auto,Auto">
                <Label Grid.Row="0" Grid.ColumnSpan="2" Text="Truy cập nhanh"
                       FontSize="18" FontAttributes="Bold" Margin="5" />

                <Button Grid.Row="1" Grid.Column="0" Margin="5"
                        Text="Quản lý phòng"
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="RoomsPage"
                        BackgroundColor="#3498db" />

                <Button Grid.Row="1" Grid.Column="1" Margin="5"
                        Text="Quản lý người thuê"
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="TenantsPage"
                        BackgroundColor="#2ecc71" />

                <Button Grid.Row="2" Grid.Column="0" Margin="5"
                        Text="Thanh toán"
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="payment_overview"
                        BackgroundColor="#e67e22" />

                <Button Grid.Row="2" Grid.Column="1" Margin="5"
                        Text="Báo cáo"
                        Command="{Binding NavigateToCommand}"
                        CommandParameter="report"
                        BackgroundColor="#9b59b6" />
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>