<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AMS.Views.RoomDetailPage"
             Title="Chi tiết phòng">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Làm mới" Order="Primary" Priority="0" Command="{Binding RefreshCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- 1) Thông tin phòng -->
            <Frame HasShadow="True" CornerRadius="16" Padding="16" BorderColor="#E0E0E0">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{DynamicResource TextPrimary}" Text="Thông tin phòng" FontAttributes="Bold" FontSize="18" />
                    <Label Style="{DynamicResource TextPrimary}" Text="{Binding Room.RoomCode, StringFormat='Mã phòng: {0}'}" />
                    <Label Style="{DynamicResource TextPrimary}" Text="{Binding Room.RoomStatus, StringFormat='Trạng thái: {0}'}" />
                    <Label Style="{DynamicResource TextPrimary}" Text="{Binding Room.Area, StringFormat='Diện tích: {0:N0} m²'}" />
                    <Label Style="{DynamicResource TextPrimary}" Text="{Binding Room.Price, StringFormat='Giá thuê: {0:N0} đ'}" />
                    <Label Style="{DynamicResource TextPrimary}">
                        <Label.Text>
                            <MultiBinding StringFormat="Có {0}/{1} người ở hiện tại">
                                <Binding Path="ActiveOccupancies.Count" />
                                <Binding Path="Room.MaxOccupants" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>

                    <!-- Hide Notes when empty/null without converter -->
                    <Label Style="{DynamicResource TextPrimary}" Text="{Binding Room.Notes, StringFormat='Ghi chú: {0}'}">
                        <Label.Triggers >
                            <DataTrigger TargetType="Label" Binding="{Binding Room.Notes}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding Room.Notes}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                </VerticalStackLayout>
            </Frame>

            <!-- 2) Người thuê hiện tại -->
            <Frame HasShadow="True" CornerRadius="16" Padding="16" BorderColor="#E0E0E0">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="4,6">
                        <Label Style="{DynamicResource TextPrimary}" Text="Người thuê hiện tại" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   HorizontalOptions="StartAndExpand"
                                   Grid.Row="0" Grid.Column="0"/>

                        <Button  Text="Thêm người thuê" 
                                    Command="{Binding AddTenantCommand}" 
                                    Grid.Row="0" Grid.Column="1"/>
                    </Grid>


                    <CollectionView ItemsSource="{Binding ActiveOccupancies}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Style="{DynamicResource TextPrimary}" Text="Chưa có người thuê." TextColor="#777" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="4,6">


                                    <Label Style="{DynamicResource TextPrimary}" Grid.Row="0" Grid.Column="0"                            
                                    Text="{Binding Tenant.FullName}" FontAttributes="Bold" />
                                    <Button Grid.Row="0" Grid.Column="1" Text="Gỡ"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveTenantCommand}"
                                           CommandParameter="{Binding .}"
                                           BackgroundColor="#E53935" TextColor="White" />

                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                        <Label Style="{DynamicResource TextPrimary}" Text="{Binding Tenant.PhoneNumber, StringFormat='📞 {0}'}" />
                                        <Label Style="{DynamicResource TextPrimary}" Text="{Binding Tenant.IdTenant, StringFormat='ID Người thuê: {0}'}" />
                                        <Label Style="{DynamicResource TextPrimary}" Text="{Binding MoveInDate, StringFormat='Ngày vào: {0:yyyy-MM-dd}'}" />
                                    </HorizontalStackLayout>
                                    
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- 3) Liên hệ khẩn cấp -->
            <Frame HasShadow="True" CornerRadius="16" Padding="16" BorderColor="#E0E0E0">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="4,6">
                        <Label Style="{DynamicResource TextPrimary}" Text="Liên hệ khẩn cấp" 
                               FontAttributes="Bold" 
                               FontSize="18" 
                               HorizontalOptions="StartAndExpand"
                               Grid.Row="0" Grid.Column="0"/>
                        <Button Text="Chọn người liên hệ" 
                                Command="{Binding ChooseEmergencyContactCommand}" 
                                Grid.Row="0" Grid.Column="1"/>
                    </Grid>

                    <Label Style="{DynamicResource TextPrimary}" Text="{Binding EmergencyContactName, StringFormat='Tên: {0}'}">
                        <Label.Triggers Style="{DynamicResource TextPrimary}">
                            <DataTrigger TargetType="Label" Binding="{Binding EmergencyContactName}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding EmergencyContactName}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Style="{DynamicResource TextPrimary}" Text="{Binding EmergencyContactPhone, StringFormat='Số điện thoại: {0}'}">
                        <Label.Triggers Style="{DynamicResource TextPrimary}">
                            <DataTrigger TargetType="Label" Binding="{Binding EmergencyContactPhone}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding EmergencyContactPhone}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                    <HorizontalStackLayout Spacing="12">
                        <Button Text="Gọi" Command="{Binding CallPhoneCommand}" CommandParameter="{Binding EmergencyContactPhone}" />
                    </HorizontalStackLayout>
                    <Label Text="Chọn 1 người thuê hiện tại làm người liên hệ." FontSize="12" TextColor="#777" />
                </VerticalStackLayout>
            </Frame>

            <!-- 4) Xe của phòng -->
            <Frame HasShadow="True" CornerRadius="16" Padding="16" BorderColor="#E0E0E0">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="4,6">

                        <Label Style="{DynamicResource TextPrimary}" Text="Xe của phòng" 
                                   FontAttributes="Bold" 
                                   FontSize="18" 
                                   HorizontalOptions="StartAndExpand" 
                                   Grid.Row="0" Grid.Column="0"/>
                        <Button Text="Thêm xe" 
                                    Command="{Binding AddBikeCommand}" 
                                    Grid.Row="0" Grid.Column="1"/>

                    </Grid>
                    <Label>
                        <Label.Text Style="{DynamicResource TextPrimary}">
                            <MultiBinding StringFormat=" Miễn phí: {0} xe • Hiện có: {1} • Phí thêm/xe: {2:N0} đ">
                                <Binding Path="Room.FreeBikeAllowance" />
                                <Binding Path="Bikes.Count" />
                                <Binding Path="Room.BikeExtraFee" />
                            </MultiBinding>
                        </Label.Text>
                    </Label>

                    <CollectionView ItemsSource="{Binding Bikes}" SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Style="{DynamicResource TextPrimary}" Text="Chưa có xe nào." TextColor="#777" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="4,6">
                                    
                                        <VerticalStackLayout>
                                        <Label Style="{DynamicResource TextPrimary}" Text="{Binding Plate, StringFormat='Biển số: {0}'}" FontAttributes="Bold" />
                                        <Label Style="{DynamicResource TextPrimary}" Text="{Binding OwnerId, StringFormat='ID Chủ sở hữu: {0}'}" />
                                        </VerticalStackLayout>

                                    <Button Style="{DynamicResource TextPrimary}" Text="Xóa" Grid.Row="0" Grid.Column="1"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveBikeCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#E53935" TextColor="White" />
                                    
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>